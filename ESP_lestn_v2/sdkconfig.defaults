# ESP-IDF SDK Configuration Defaults for ESP-Lestn v2

# 1. Flash Memory Configuration (4MB Flash Size required for Dual OTA)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# 2. Partition Table (Dual OTA: 2 x ~1.9MB app slots)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# 3. HTTP Server Header Buffer Size (Fixes 'Header fields are too long' HTTP 431)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=4096
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_HTTPD_ERR_RESP_NO_DELAY=y

# 4. FreeRTOS & System Performance
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y

# 5. RMT WS2812 Driver
CONFIG_RMT_ISR_IRAM_SAFE=y
